// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Operator {
  id        String   @id @default(uuid())
  name      String
  extension String   @unique
  status    String   @default("oflayn") // onlayn, oflayn
  username  String   @unique
  password  String
  role      String   @default("operator") // operator, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls Call[]
  deals Deal[]
}

model Call {
  id            String   @id @default(uuid())
  direction     String   // kiruvchi, chiquvchi
  fromNumber    String   @map("from_number")
  toNumber      String   @map("to_number")
  startTime     DateTime @default(now()) @map("start_time")
  endTime       DateTime? @map("end_time")
  duration      Int      @default(0) // seconds
  recordingPath String?  @map("recording_path")
  status        String   @default("yakunlandi") // yakunlandi, javobsiz
  callId        String?  @unique @map("call_id")
  operatorId    String?  @map("operator_id")
  contactId     String?  @map("contact_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  operator Operator? @relation(fields: [operatorId], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id])

  @@index([startTime])
  @@index([fromNumber])
  @@index([contactId])
  @@index([operatorId])
  @@map("calls")
}

model Chat {
  id             String   @id @default(uuid())
  channel        String   // telegram, instagram, facebook
  externalUserId String   @map("external_user_id")
  userName       String?  @map("user_name")
  contactId      String?  @map("contact_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages Message[]
  contact  Contact? @relation(fields: [contactId], references: [id])

  @@unique([channel, externalUserId])
  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  sender    String   // mijoz, operator
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  company     String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  calls Call[]
  chats Chat[]
  deals Deal[]

  @@index([phone])
  @@map("contacts")
}

model SipTrunk {
  id          String   @id @default(uuid())
  name        String   @unique
  host        String
  username    String
  password    String
  port        Int      @default(5060)
  transport   String   @default("udp") // udp, tcp, tls
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sip_trunks")
}

model SipExtension {
  id          String   @id @default(uuid())
  extension   String   @unique
  password    String
  displayName String?  @map("display_name")
  context     String   @default("from-internal")
  transport   String   @default("transport-udp")
  codecs      String   @default("ulaw,alaw,g729") // comma-separated
  status      String   @default("unavailable") // unavailable, available
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sip_extensions")
}

model Pipeline {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages Stage[]
  deals  Deal[]

  @@map("pipelines")
}

model Stage {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("#3b82f6")
  order      Int      @default(0)
  pipelineId String   @map("pipeline_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@map("stages")
}

model Deal {
  id          String   @id @default(uuid())
  title       String
  amount      Float    @default(0)
  pipelineId  String   @map("pipeline_id")
  stageId     String   @map("stage_id")
  contactId   String?  @map("contact_id")
  operatorId  String?  @map("operator_id")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipeline Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@map("deals")
}


